# CONFIG_CAMERA_SC2336 is not set
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y

CONFIG_EXAMPLE_SELECT_ESP32P4_FUNCTION_EV_BOARD_V1_5=y
CONFIG_EXAMPLE_SCCB_I2C_INIT_BY_APP=y

CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768



# 16MB Flash (Waveshare board)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# ESP32-P4 rev v0.x/v1.x engineering sample support
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y

# ESP-HOSTED: SDIO + C6 for Waveshare ESP32-P4-WIFI6-DEV-KIT
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"
# Use the ESP32-P4 Function EV board SDIO pinout. The Waveshare
# ESP32-P4-WIFI6-DEV-KIT routes its on-board C6 the same way.
# CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE is not set
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y

# USB UVC 摄像头支持（双 USB 摄像头接在 HOST 模式的 2号口和3号口）
CONFIG_ESP_VIDEO_ENABLE_USB_UVC_VIDEO_DEVICE=y
CONFIG_EXAMPLE_ENABLE_USB_UVC_CAM_SENSOR=y
# CONFIG_EXAMPLE_USB_MINIMAL_VALIDATION_MODE is not set
CONFIG_EXAMPLE_USB_NETWORK_VALIDATION_MODE=y
# CONFIG_EXAMPLE_USB_HUB_VALIDATION_MODE is not set
CONFIG_EXAMPLE_USB_CSI_NETWORK_VALIDATION_MODE=y
# CONFIG_EXAMPLE_DUAL_USB_NETWORK_VALIDATION_MODE is not set
CONFIG_EXAMPLE_USB_UVC_DEVICES_NUM=1
CONFIG_EXAMPLE_USB_UVC_TASK_STACK_SIZE=6144
CONFIG_EXAMPLE_USB_UVC_TASK_PRIORITY=12
CONFIG_EXAMPLE_USB_UVC_TASK_AFFINITY=1
CONFIG_EXAMPLE_USB_LIB_TASK_STACK_SIZE=6144
CONFIG_EXAMPLE_USB_LIB_TASK_PRIORITY=11
CONFIG_EXAMPLE_USB_LIB_TASK_AFFINITY=1
# Waveshare routes the CH334 upstream pair to ESP32-P4 USB-DWC HS (BIT0).
CONFIG_EXAMPLE_USB_PERIPHERAL_MAP=0x1
CONFIG_USB_UVC_INIT_TIMEOUT_MS=30000
CONFIG_EXAMPLE_CAMERA_VIDEO_BUFFER_NUMBER=4
CONFIG_EXAMPLE_USB_CAMERA_VIDEO_BUFFER_NUMBER=8
CONFIG_EXAMPLE_USB_UVC_URB_NUMBER=8
CONFIG_USB_UVC_VIDEO_DEVICE_URB_SIZE=65536
# CONFIG_UVC_PRINTF_CONFIGURATION_DESCRIPTOR is not set
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y

CONFIG_EXAMPLE_JPEG_COMPRESSION_QUALITY=60
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535

# CSI camera: fixed landscape 1920x1080 target
CONFIG_CAMERA_OV5647_MIPI_RAW10_1280X960_BINNING_45FPS=y
CONFIG_CAMERA_OV5647_MIPI_RAW10_1920X1080_30FPS=y
# CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW10_1920X1080_30FPS is not set
CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW10_1280X960_BINNING_45FPS=y
CONFIG_CAMERA_OV5647_MIPI_IF_FORMAT_INDEX_DEFAULT=4
# CONFIG_CAMERA_OV5647_MIPI_RAW8_800X1280_50FPS is not set
# CONFIG_CAMERA_OV5647_MIPI_RAW8_800X800_50FPS is not set

# USB HUB support for Waveshare ESP32-P4 (CH334 hub on ports 2-4)
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y
CONFIG_USB_HOST_DWC_DMA_CAP_MEMORY_IN_PSRAM=y
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=3200
CONFIG_USB_HOST_EXT_PORT_RESET_ATTEMPTS=3
